# ===== ml-service Environment Variables =====
# Copy to .env and adjust for your environment

# App
APP_NAME=ml-service
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql+asyncpg://mdm_user:mdm_password@localhost:5432/mdm_ml
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache
REDIS_URL=redis://localhost:6379/3
CACHE_TTL_SECONDS=300

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ml-service
KAFKA_TOPIC_CUSTOMER_EVENTS=customer.events
KAFKA_TOPIC_TRANSACTION_EVENTS=transaction.events
KAFKA_AUTO_OFFSET_RESET=earliest

# ML Model
MODEL_DIR=/app/models
MODEL_AUTO_TRAIN=false
MODEL_RETRAIN_INTERVAL_HOURS=24

# Auth
JWT_SECRET=change-me-in-production-use-vault
JWT_ALGORITHM=HS256
JWT_AUDIENCE=mdm-platform

# Customer Service
CUSTOMER_SERVICE_URL=http://localhost:8080
CUSTOMER_SERVICE_TIMEOUT=5

# Feature Store
FEATURE_STORE_TYPE=redis
FEATURE_STORE_TTL=3600

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ml-service
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp

# Batch Prediction
BATCH_MAX_CUSTOMERS=1000
BATCH_CONCURRENCY=10
BATCH_TIMEOUT_SECONDS=300

# Feature flags
FEATURE_CHURN_ENABLED=true
FEATURE_RISK_ENABLED=true
FEATURE_SEGMENT_ENABLED=true
FEATURE_ANOMALY_ENABLED=true
FEATURE_CLV_ENABLED=true
FEATURE_BATCH_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
