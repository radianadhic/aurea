<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bankxyz.mdm</groupId>
    <artifactId>mdm-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>MDM Backend (Parent)</name>
    <description>MDM Bank XYZ - Backend parent project managing all 13 microservices</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <springdoc.version>2.3.0</springdoc.version>
        <testcontainers.version>1.19.7</testcontainers.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.30</lombok.version>
        <hypersistence-utils.version>3.7.0</hypersistence-utils.version>
    </properties>

    <modules>
        <module>../templates/spring-boot/mdm-common</module>
        <module>auth-service</module>
        <module>customer-service</module>
        <!--
        <module>matching-service</module>
        <module>audit-service</module>
        <module>notification-service</module>
        <module>workflow-service</module>
        <module>product-service</module>
        <module>branch-service</module>
        <module>report-service</module>
        <module>ml-service</module>
        <module>integration-service</module>
        <module>document-service</module>
        <module>admin-service</module>
        <module>api-gateway</module>
        -->
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bankxyz.mdm</groupId>
                <artifactId>mdm-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
