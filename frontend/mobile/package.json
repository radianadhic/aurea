{
  "name": "bank-xyz-mobile",
  "version": "1.0.0",
  "description": "Bank XYZ Mobile App - Customer onboarding, e-KYC, account management",
  "productName": "Bank XYZ",
  "author": "Bank XYZ <mdm@bankxyz.co.id>",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.ts,.vue ./",
