"""Authentication endpoints (FastAPI template example)."""
from fastapi import APIRouter, Depends, Header, HTTPException, status
import structlog

from app.core.security import get_current_user, require_role
from app.schemas.auth import UserInfo, TokenValidationResponse

logger = structlog.get_logger(__name__)
router = APIRouter()


@router.get("/me", response_model=UserInfo, summary="Get current user info")
async def get_me(current_user: dict = Depends(get_current_user)):
    """Get information about the currently authenticated user."""
    return UserInfo(**current_user)


@router.get("/validate", response_model=TokenValidationResponse, summary="Validate token")
async def validate_token(current_user: dict = Depends(get_current_user)):
    """Validate the access token (used by API Gateway)."""
    return TokenValidationResponse(
        valid=True,
        userId=current_user.get("sub"),
        username=current_user.get("preferred_username"),
    )
