[project]
name = "{{SERVICE_NAME}}"
version = "1.0.0"
description = "{{SERVICE_DESCRIPTION}}"
authors = [
    {name = "MDM Bank XYZ Team", email = "mdm-team@bankxyz.co.id"}
]
readme = "README.md"
requires-python = ">=3.12"
license = {text = "Proprietary"}

dependencies = [
    # Web framework
    "fastapi>=0.109.0",
    "uvicorn[standard]>=0.27.0",
    "python-multipart>=0.0.6",
    "jinja2>=3.1.2",

    # Data validation
    "pydantic>=2.5.0",
    "pydantic-settings>=2.1.0",
    "email-validator>=2.1.0",

    # Database
    "sqlalchemy>=2.0.25",
    "asyncpg>=0.29.0",
    "psycopg2-binary>=2.9.9",
    "alembic>=1.13.1",
    "sqlmodel>=0.0.16",

    # Redis
    "redis>=5.0.1",
    "aioredis>=2.0.1",

    # Kafka
    "aiokafka>=0.10.0",
    "confluent-kafka>=2.3.0",

    # Security
    "python-jose[cryptography]>=3.3.0",
    "passlib[bcrypt]>=1.7.4",
    "pyjwt[crypto]>=2.8.0",

    # HTTP client
    "httpx>=0.25.2",
    "aiohttp>=3.9.1",
    "requests>=2.31.0",

    # ML
    "numpy>=1.26.2",
    "pandas>=2.1.4",
    "scikit-learn>=1.3.2",
    "xgboost>=2.0.3",
    "lightgbm>=4.3.0",
    "tensorflow>=2.15.0",
    "torch>=2.1.1",
    "transformers>=4.35.2",
    "mlflow>=2.9.2",
    "shap>=0.44.0",

    # Observability
    "prometheus-client>=0.19.0",
    "opentelemetry-api>=1.22.0",
    "opentelemetry-sdk>=1.22.0",
    "opentelemetry-instrumentation-fastapi>=0.43b0",
    "opentelemetry-exporter-otlp>=1.22.0",

    # Logging
    "structlog>=24.1.0",
    "loguru>=0.7.2",

    # Utilities
    "tenacity>=8.2.3",
    "pyyaml>=6.0.1",
    "python-dotenv>=1.0.0",
    "orjson>=3.9.10",
    "pendulum>=3.0.0",
    "cryptography>=41.0.7",
    "pyotp>=2.9.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4.3",
    "pytest-asyncio>=0.23.3",
    "pytest-cov>=4.1.0",
    "pytest-mock>=3.12.0",
    "httpx>=0.25.2",
    "faker>=22.0.0",
    "freezegun>=1.4.0",
    "mypy>=1.7.1",
    "ruff>=0.1.6",
    "black>=23.11.0",
    "isort>=5.12.0",
    "ipython>=8.18.1",
]

[build-system]
requires = ["poetry-core>=1.0.0"]
build-backend = "poetry.core.masonry.api"

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "B", "C4", "SIM", "RUF"]
ignore = ["E501"]

[tool.black]
line-length = 100
target-version = ["py312"]

[tool.mypy]
python_version = "3.12"
strict = true
ignore_missing_imports = true

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
